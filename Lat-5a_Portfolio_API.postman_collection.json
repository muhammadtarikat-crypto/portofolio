    {
      "name": "GET Project Detail",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/portfolio/projects/{{slug}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns the project matching the slug', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql('success');",
              "    pm.expect(body.data.slug).to.eql(pm.collectionVariables.get('slug'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET Project Detail - Unknown Slug",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/portfolio/projects/project-that-does-not-exist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns a consistent JSON 404 response', function () {",
              "    pm.response.to.have.status(404);",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql('error');",
              "    pm.expect(body.data).to.eql(null);",
              "});"
            ]
          }
        }
      ]
    },
